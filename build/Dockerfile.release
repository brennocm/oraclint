# Image published by GoReleaser: the binary is built by GoReleaser and copied
# per platform. distroless/static:nonroot has no shell and runs as UID 65532.
# Base pinned by digest; Dependabot keeps it current.
FROM gcr.io/distroless/static:nonroot@sha256:d62067879de890a1def9da0e7766b7d20810a5e5555cef8506b752437d7a3e88
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/oraclint /usr/bin/oraclint
USER nonroot:nonroot
WORKDIR /src
ENTRYPOINT ["/usr/bin/oraclint"]
